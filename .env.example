# Copy to .env for local development — or just run `npm run setup`, which
# writes this file for you (it prompts for the password).
#
# Local Postgres (e.g. `docker run --name pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16`):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/test

# "disable" for a local Postgres and for Railway's private network.
# "require" only when connecting through Railway's public TCP proxy
# (the Postgres service's DATABASE_PUBLIC_URL).
DATABASE_SSL=disable

# On Railway you do NOT set these by hand: .railway/railway.ts wires
# DATABASE_URL to the Postgres service and sets DATABASE_SSL=disable.
